# ==============================================================================
# HORRAGOR v3 — Fichier de configuration des variables d'environnement
# ==============================================================================
# 1. Copie ce fichier : cp example.env .env
# 2. Remplis chaque variable ci-dessous
# 3. Ne commite JAMAIS le .env (vérifie que .gitignore contient bien ".env")
# ==============================================================================


# ------------------------------------------------------------------------------
# SUPABASE — Base de données PostgreSQL
# ------------------------------------------------------------------------------
# 📍 Où trouver ces infos :
#    → https://supabase.com/dashboard → ton projet → Settings → Database
#    → Section "Connection string" → Mode "Transaction" (port 6543)
#    → Remplace [id] par ton Project ID et [mot de passe] par ton DB password
#
# ⚠️  Utilise le port 6543 (Transaction mode, compatible SQLAlchemy)
#     et NON le port 5432 (Session mode, timeout sur Supabase gratuit)

SUPABASE_URL="postgresql://postgres.[id]:[mot de passe]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"


# ------------------------------------------------------------------------------
# LANGFUSE — Monitoring et observabilité des agents LLM
# ------------------------------------------------------------------------------
# 📍 Où trouver ces clés :
#    → Lance Langfuse en local via Docker :
#         git clone https://github.com/langfuse/langfuse.git
#         cd langfuse && docker compose up -d
#    → Ouvre http://localhost:3000
#    → Crée un compte (un faux mail fonctionne en local)
#    → Crée un nouveau projet → Settings → API Keys
#    → Copie la "Secret Key" (sk-lf-...) et la "Public Key" (pk-lf-...)
#
# ℹ️  En production (Langfuse Cloud) : https://cloud.langfuse.com
#     et remplace LANGFUSE_HOST par "https://cloud.langfuse.com"

LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_HOST="http://localhost:3000"


# ------------------------------------------------------------------------------
# TMDB — The Movie Database API (enrichissement du parquet)
# ------------------------------------------------------------------------------
# 📍 Où trouver cette clé :
#    → Crée un compte gratuit sur https://www.themoviedb.org/signup
#    → Va dans Settings → API : https://www.themoviedb.org/settings/api
#    → Clique "Create" → choisis "Developer" → accepte les CGU
#    → Remplis le formulaire (nom : HorRAGor, usage : educational, URL : http://localhost)
#    → Copie la "API Key" (32 caractères, pas le Read Access Token)
#
# ℹ️  Utilisée par :
#     - enrich_parquet.py  → enrichit le parquet avec réalisateur, casting, genres...
#     - supabase_db.py     → détecte la clé et affiche les instructions d'enrichissement
#
# ⚠️  La clé peut prendre quelques minutes à s'activer après création

TMDB_API_KEY=""